{
  "version": 2,
  "name": "trek-maroc",
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide",
      "destination": "/pages/guide.html",
      "permanent": true
    },
    {
      "source": "/treks",
      "destination": "/pages/treks.html",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/pages/gallery.html",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/pages/reviews.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/pages/booking.html",
      "permanent": true
    }
  ]
}